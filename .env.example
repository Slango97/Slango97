# Copy to .env (never commit .env). Real environment variables take precedence over this file.

# --- mode: DRY_RUN (analyze + log only) -> DEMO (orders on a demo account) -> LIVE (real money) ---
AGENT_MODE=DRY_RUN
# LIVE additionally requires this exact value, and the connected account must be a REAL account:
# CONFIRM_LIVE=YES_I_UNDERSTAND

# --- broker ---
SYMBOL=AUTO                   # automatically detect this broker's gold symbol (XAUUSD, XAUUSDs, GOLD, suffixes, etc.)
# Set SYMBOL=XAUUSDs (or another exact name) only when you intentionally want to pin the instrument.
# Symbol discovery also inspects the MT5 terminal inventory using contract properties; no broker-specific suffix list is required.
# SERVER_UTC_OFFSET=2         # broker server time vs UTC in hours; set it if auto-detection looks wrong
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# MT5_LOGIN=12345678
# MT5_PASSWORD=
# MT5_SERVER=BrokerName-Demo

# --- market intelligence (optional; without it the agent trades on technicals, news stays neutral) ---
FEATURES__USE_LLM=false            # the ONLY switch for kernel LLM news intelligence (advisory; never trades)
INTEL__PROVIDER=none               # anthropic | openai | openai_compatible | none (used only when FEATURES__USE_LLM=true)
ANTHROPIC_API_KEY=
# INTEL__ANTHROPIC_MODEL=claude-sonnet-5-5
# INTEL__WEB_SEARCH=false          # true lets the model search the web (slower, costs more)
# TRADING_ECONOMICS_API_KEY=      # optional independent economic-calendar provider
# OPENAI_API_KEY=
# INTEL__OPENAI_MODEL=             # required when INTEL__PROVIDER=openai

# --- alerts (optional; set any) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ALERT_EMAIL_TO=

# --- any config field can be overridden as SECTION__FIELD ---
# RISK__RISK_PER_TRADE_PCT=0.25
# RISK__MAX_DAILY_LOSS_PCT=1.5
# STRATEGY__MIN_SCORE=70
# EXECUTION__MAX_SPREAD_POINTS=35
# SIZING__MODE=fixed               # tiered only after testing it with optimize.py --group sizing
# POLICY__USE_CALIBRATION=false    # needs data/calibration.json from optimize.py --save-models
# POLICY__USE_EDGE_BOOK=false      # needs data/edge_book.json from optimize.py --save-models
# POLICY__USE_CONTRADICTION=true

# --- V4 ---
# V4.1 hardening defaults: calendar failure is fail-closed; min-lot sizing never exceeds risk budget.
# V4_FEATURES=off                  # reproduce V3 behaviour (regression comparison)
# FEATURES__M1_REFINEMENT=true     # any single V4 feature can be switched off: FEATURES__<NAME>=false
# M1__WINDOW_MIN=10
# RELIABILITY__BACKOFF_MAX_S=120
# NOTIFY__REJECTED_MIN_SCORE=55
# SESSIONS__SPLIT_ASIA=false       # enable only if the session report shows Sydney/Tokyo behave differently
# NEWS__BLOCK_IF_CALENDAR_UNAVAILABLE=true
# NEWS__CALENDAR_MIN_REMOTE_FAMILIES=1
# INTEL__FALLBACK_PROVIDERS=openai_compatible
# INTEL__COMPAT_BASE_URL=          # OpenAI-compatible endpoint (e.g. Grok/xAI); unverified here
# INTEL__COMPAT_MODEL=
# COMPAT_API_KEY=

# --- V4.2 / V4.3 ---
# REGISTRY_HMAC_KEY=               # sign registry entries; promotion then requires a valid signature
# FEATURES__MACRO_FEEDS=false      # dollar index / US10Y / EURUSD drivers as contradiction evidence
# FEATURES__LIMIT_ENTRIES=false    # limit orders at the zone midpoint instead of market entries
# EXECUTION__LIMIT_EXPIRY_MIN=30
# POLICY__USE_META_MODEL=false     # learned filter (needs an approved meta_model in the registry)
# POLICY__META_MIN_PROB=0.5
# FEATURES__SHADOW_MODE=false
# SHADOW__PARAMS_VERSION=          # registry id of the candidate to shadow
# SHADOW__META_VERSION=
# FEATURES__TELEGRAM_COMMANDS=false
# TELEGRAM_COMMAND_PIN=            # required for /resume and /flatten
# TELEGRAM_ALLOWED_USER_IDS=       # optional extra allow-list
# SESSIONS__DST_AWARE=false        # London/New York phases follow daylight saving
# NEWS__CALENDAR_STRICT_ALL_FAMILIES=false

# --- V4.3 pro-trader hardening ---
# POLICY__MIN_PRO_QUALITY_SCORE=62
# POLICY__HIGH_VOL_QUALITY_FLOOR=68
# RISK__ADAPTIVE_QUALITY_RISK=true
# RISK__CAUTIOUS_RISK_MULT=0.70
# RISK__HIGH_VOL_RISK_MULT=0.70
# RISK__EXPANSION_RISK_MULT=0.80
# RISK__NEWS_CAUTION_RISK_MULT=0.60
# EXECUTION__REQUIRE_ORDER_CHECK=true
# EXECUTION__SERVER_TIME_MAX_DRIFT_S=10
# EXECUTION__PENDING_REVALIDATE_ON_FILL=true
# NEWS__CALENDAR_TRADE_MAX_AGE_H=4


# --- V5 Ultimate Brain ---
# Python-native brain/workflow runtime; no OpenAI Agents SDK or n8n is required.
BRAIN__ENABLED=true
BRAIN__ENFORCE=false              # advisory/shadow by default; enable only after DRY_RUN/DEMO validation
BRAIN__MAX_WORKERS=4
BRAIN__HEALTH_REPORT_INTERVAL_MIN=60
BRAIN__OPPORTUNITY_REPORT_THRESHOLD=80
BRAIN__NO_TRADE_REPORT_THRESHOLD=55
BRAIN__TELEGRAM_CHARTS=true
BRAIN__UNIVERSE_ENABLED=true
BRAIN__UNIVERSE_REFRESH_MIN=60
BRAIN__UNIVERSE_BARS=180
BRAIN__UNIVERSE_MAX_SYMBOLS=12
BRAIN__LLM_ENABLED=false          # optional direct OpenAI model reasoning; still cannot override risk/execution
BRAIN__LLM_MAX_TOKENS=900
BRAIN__LLM_TIMEOUT_S=8
# BRAIN__WATCHLIST=XAUUSD,EURUSD,GBPUSD,USDJPY,XAGUSD,US30,NAS100,USOIL,BTCUSD,AUDUSD,USDCAD,USDCHF

# --- V5.1 ---
# FEATURES__DOC_RULES=true              # trading documents' rules (impact windows, two-loss lock, cooldown, TP1/TP2, checklist)
# EVENTS__HIGH_IMPACT_PRE_MIN=60        # no entries before red news (checklist: 60; Blueprint minimum: 30)
# EVENTS__HIGH_IMPACT_INITIAL_REACTION_MIN=15
# NEWS__HTTP_CONTACT=you@example.com    # optional: identifies the agent to bls.gov if it refuses requests
# RISK__TWO_LOSS_LOCK_AFTER=2
# RISK__LOSS_COOLDOWN_MIN=15
# NOTIFY__PREMARKET_HOUR_UTC=6
# Multiple markets: START_MULTI_V5_WINDOWS.bat XAUUSD EURUSD US30   (each gets data\SYMBOL)
